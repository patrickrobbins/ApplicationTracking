@model DependencyTracker.Web.Models.ViewModels.ActivityLogViewModel

@{
    ViewBag.Title = "Activity Log";
}

<div class="page-header d-flex justify-content-between align-items-center mt-3 mb-4">
    <h1 class="h3 mb-0">Activity Log</h1>
</div>

@* Filter *@
<div class="card shadow-sm mb-4">
    <div class="card-body">
        @using (Html.BeginForm("ActivityLog", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
        {
            <div class="col-md-3">
                <label class="form-label small text-muted">Entity Type</label>
                <select name="entityType" class="form-select">
                    <option value="">All</option>
                    @foreach (var type in new[] { "Application", "Dependency", "ADGroup", "System" })
                    {
                        <option value="@type" @(Model.EntityType == type ? "selected" : "")>@type</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Action</label>
                <select name="action" class="form-select">
                    <option value="">All</option>
                    @foreach (var action in new[] { "Created", "Updated", "Deleted" })
                    {
                        <option value="@action" @(Model.Action == action ? "selected" : "")>@action</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">User</label>
                <input type="text" name="user" value="@Model.User" class="form-control" placeholder="Search user..." />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date (UTC)</th>
                    <th>Action</th>
                    <th>Entity Type</th>
                    <th>Entity</th>
                    <th>Details</th>
                    <th>Performed By</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Entries.Any())
                {
                    <tr><td colspan="6" class="text-muted text-center py-4">No activity found.</td></tr>
                }
                @foreach (var log in Model.Entries)
                {
                    <tr>
                        <td class="text-muted small">@log.PerformedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="badge @ActionBadge(log.Action)">@log.Action</span></td>
                        <td class="small">@log.EntityType</td>
                        <td class="fw-semibold">@log.EntityName</td>
                        <td class="small text-muted">@log.Details</td>
                        <td class="small">@log.PerformedBy</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    private string ActionBadge(string action)
    {
        switch (action)
        {
            case "Created": return "bg-success";
            case "Updated": return "bg-info text-dark";
            case "Deleted": return "bg-danger";
            default: return "bg-secondary";
        }
    }
}
