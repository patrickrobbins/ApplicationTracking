@model IEnumerable<DependencyTracker.Data.Models.ApplicationType>

@{
    ViewBag.Title = "Application Types";
}

<div class="page-header d-flex justify-content-between align-items-center mt-3 mb-4">
    <h1 class="h3 mb-0">Application Types</h1>
    <div class="btn-group">
        <a href="@Url.Action("ApplicationTypeCreate", "Admin")" class="btn btn-primary">+ New Application Type</a>
        <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary">Back to Admin</a>
    </div>
</div>

<div class="alert alert-info">
    Application types describe what kind of system each application is
    (for example: <strong>Batch Job</strong>, <strong>Web Site</strong>,
    <strong>Web API</strong>, <strong>Windows Service</strong>,
    <strong>Desktop Application</strong>, <strong>Mobile Application</strong>,
    <strong>Cloud Service</strong>). The list is maintained here and shown on
    the application form and details page.
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Sort</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="fw-semibold">@t.Name</td>
                        <td class="text-muted">@(t.Description ?? "-")</td>
                        <td><span class="badge bg-light text-dark border">@t.SortOrder</span></td>
                        <td>
                            @if (t.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="@Url.Action("ApplicationTypeEdit", "Admin", new { id = t.ApplicationTypeId })"
                               class="btn btn-sm btn-outline-secondary">Edit</a>
                            @using (Html.BeginForm("ApplicationTypeToggle", "Admin", new { id = t.ApplicationTypeId }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                    @(t.IsActive ? "Deactivate" : "Activate")
                                </button>
                            }
                            @using (Html.BeginForm("ApplicationTypeDelete", "Admin", new { id = t.ApplicationTypeId }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Remove application type \'@t.Name\'? Affected applications are left untyped.');">Delete</button>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-muted text-center py-3">No application types configured.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>