@model IEnumerable<DependencyTracker.Data.Models.ApplicationCategory>

@{
    ViewBag.Title = "Categories";
}

<div class="page-header d-flex justify-content-between align-items-center mt-3 mb-4">
    <h1 class="h3 mb-0">Application Categories</h1>
    <div class="btn-group">
        <a href="@Url.Action("CategoryCreate", "Admin")" class="btn btn-primary">+ New Category</a>
        <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary">Back to Admin</a>
    </div>
</div>

<div class="alert alert-info">
    Categories classify applications so dependencies can be tracked by type (for example:
    <strong>Internal</strong>, <strong>External</strong>, <strong>Library</strong>,
    <strong>Database</strong>, <strong>Active Directory</strong>). This list is dynamic;
    applications reference a category through a nullable foreign key.
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Sort</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.Name</td>
                        <td class="text-muted">@(c.Description ?? "-")</td>
                        <td><span class="badge bg-light text-dark border">@c.SortOrder</span></td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="@Url.Action("CategoryEdit", "Admin", new { id = c.CategoryId })"
                               class="btn btn-sm btn-outline-secondary">Edit</a>
                            @using (Html.BeginForm("CategoryToggle", "Admin", new { id = c.CategoryId }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                    @(c.IsActive ? "Deactivate" : "Activate")
                                </button>
                            }
                            @using (Html.BeginForm("CategoryDelete", "Admin", new { id = c.CategoryId }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Remove category \'@c.Name\'? Applications using it become uncategorized.');">Delete</button>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-muted text-center py-3">No categories configured.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
