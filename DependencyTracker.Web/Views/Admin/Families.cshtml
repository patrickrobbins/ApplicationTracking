@model IEnumerable<DependencyTracker.Data.Models.ApplicationFamily>

@{
    ViewBag.Title = "Families";
}

<div class="page-header d-flex justify-content-between align-items-center mt-3 mb-4">
    <h1 class="h3 mb-0">Application Families</h1>
    <div class="btn-group">
        <a href="@Url.Action("FamilyCreate", "Admin")" class="btn btn-primary">+ New Family</a>
        <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary">Back to Admin</a>
    </div>
</div>

<div class="alert alert-info">
    Application families group related applications (for example:
    <strong>Business Applications</strong>, <strong>Shared Services</strong>,
    <strong>Data &amp; Analytics</strong>, <strong>Infrastructure</strong>).
    Each application belongs to at most one family; the list is maintained here
    and selected on the application create/edit form.
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Sort</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td class="fw-semibold">@f.Name</td>
                        <td class="text-muted">@(f.Description ?? "-")</td>
                        <td><span class="badge bg-light text-dark border">@f.SortOrder</span></td>
                        <td>
                            @if (f.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="@Url.Action("FamilyEdit", "Admin", new { id = f.FamilyId })"
                               class="btn btn-sm btn-outline-secondary">Edit</a>
                            @using (Html.BeginForm("FamilyToggle", "Admin", new { id = f.FamilyId }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                    @(f.IsActive ? "Deactivate" : "Activate")
                                </button>
                            }
                            @using (Html.BeginForm("FamilyDelete", "Admin", new { id = f.FamilyId }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Remove family \'@f.Name\'? Applications using it become unfamilied.');">Delete</button>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-muted text-center py-3">No families configured.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>