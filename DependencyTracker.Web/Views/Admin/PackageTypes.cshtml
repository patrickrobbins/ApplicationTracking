@model IEnumerable<DependencyTracker.Data.Models.PackageType>

@{
    ViewBag.Title = "Package Types";
}

<div class="page-header d-flex justify-content-between align-items-center mt-3 mb-4">
    <h1 class="h3 mb-0">Package Types</h1>
    <div class="btn-group">
        <a href="@Url.Action("PackageTypeCreate", "Admin")" class="btn btn-primary">+ New Package Type</a>
        <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary">Back to Admin</a>
    </div>
</div>

<div class="alert alert-info">
    Package types are the ecosystems from which an application's packages come
    (for example: <strong>Npm</strong>, <strong>NuGet</strong>). Each package
    belongs to exactly one type; the list is maintained here and used by the
    package rows on the application create/edit form.
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Sort</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="fw-semibold">@t.Name</td>
                        <td class="text-muted">@(t.Description ?? "-")</td>
                        <td><span class="badge bg-light text-dark border">@t.SortOrder</span></td>
                        <td>
                            @if (t.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="@Url.Action("PackageTypeEdit", "Admin", new { id = t.PackageTypeId })"
                               class="btn btn-sm btn-outline-secondary">Edit</a>
                            @using (Html.BeginForm("PackageTypeToggle", "Admin", new { id = t.PackageTypeId }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                    @(t.IsActive ? "Deactivate" : "Activate")
                                </button>
                            }
                            @using (Html.BeginForm("PackageTypeDelete", "Admin", new { id = t.PackageTypeId }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Remove package type \'@t.Name\'? Packages of that type are removed from every application.');">Delete</button>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-muted text-center py-3">No package types configured.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>