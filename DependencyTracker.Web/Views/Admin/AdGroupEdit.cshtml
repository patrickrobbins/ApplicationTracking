@model DependencyTracker.Web.Models.ViewModels.AdGroupViewModel

@{
    ViewBag.Title = "Edit AD Group";
}

<div class="page-header mt-3 mb-4">
    <h1 class="h3 mb-0">Edit AD Group</h1>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                @using (Html.BeginForm("AdGroupEdit", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.GroupId)
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        <label class="form-label">Group Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.GroupName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.GroupName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Role <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.Role, Model.RoleOptions, new { @class = "form-select" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3 })
                    </div>

                    <div class="form-check form-switch mb-4">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                        <label class="form-check-label" for="IsActive">Active</label>
                    </div>

                    <div>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a href="@Url.Action("AdGroups", "Admin")" class="btn btn-outline-secondary ms-1">Cancel</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
