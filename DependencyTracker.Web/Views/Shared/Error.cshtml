@model System.Web.Mvc.HandleErrorInfo

@{
    ViewBag.Title = "Error";
    var isLocal = HttpContext.Current != null && HttpContext.Current.Request != null && HttpContext.Current.Request.IsLocal;
    var requestId = HttpContext.Current != null && HttpContext.Current.Items["ErrorRequestId"] != null
        ? HttpContext.Current.Items["ErrorRequestId"].ToString()
        : null;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h1 class="display-4 text-danger">Oops!</h1>
                <p class="lead">An unexpected error occurred while processing your request.</p>
                @if (isLocal && Model != null && Model.Exception != null)
                {
                    <p class="text-muted small">@Model.Exception.Message</p>
                    <pre class="text-start small text-muted" style="max-height: 35vh; overflow: auto;">@Model.Exception.StackTrace</pre>
                }
                else
                {
                    <p class="text-muted small">
                        The details were written to the application error log@(string.IsNullOrEmpty(requestId) ? "." : " (reference " + requestId + ").")
                    </p>
                }
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Return to Dashboard</a>
            </div>
        </div>
    </div>
</div>
