@{
    ViewBag.Title = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card shadow-sm border-danger">
            <div class="card-body text-center py-5">
                <h1 class="display-4 text-danger">Access Denied</h1>
                <p class="lead">You do not have permission to view this page.</p>
                <p class="text-muted">
                    This action requires a higher level of access. If you believe this is an error,
                    contact your system administrator to have your Active Directory group membership
                    updated.
                </p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Return to Dashboard</a>
            </div>
        </div>
    </div>
</div>
