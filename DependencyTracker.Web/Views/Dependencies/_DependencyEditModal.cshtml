@model DependencyTracker.Web.Models.ViewModels.DependencyFormViewModel
@{
    Layout = null;
}

<div class="modal-header">
    <h5 class="modal-title">Edit Dependency</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form id="depEditForm" action="@Url.Action("EditModal", "Dependencies")" method="post">
    @Html.AntiForgeryToken()
    <div class="modal-body">
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
        @Html.HiddenFor(m => m.DependencyId)

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Source Application <span class="text-danger">*</span></label>
                @Html.DropDownListFor(m => m.SourceApplicationId, Model.ApplicationOptions, "Select application...", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.SourceApplicationId, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-6">
                <label class="form-label">Target Application <span class="text-danger">*</span></label>
                @Html.DropDownListFor(m => m.TargetApplicationId, Model.ApplicationOptions, "Select application...", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.TargetApplicationId, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-4">
                <label class="form-label">Dependency Type <span class="text-danger">*</span></label>
                @Html.DropDownListFor(m => m.DependencyType, Model.TypeOptions, new { @class = "form-select" })
            </div>
            <div class="col-md-4">
                <label class="form-label">Direction</label>
                @Html.DropDownListFor(m => m.Direction, Model.DirectionOptions, new { @class = "form-select" })
            </div>
            <div class="col-md-4">
                <label class="form-label">Criticality</label>
                @Html.DropDownListFor(m => m.CriticalityLevel, Model.CriticalityOptions, new { @class = "form-select" })
            </div>
            <div class="col-md-4">
                <label class="form-label">Frequency</label>
                @Html.DropDownListFor(m => m.Frequency, Model.FrequencyOptions, "Select...", new { @class = "form-select" })
            </div>
            <div class="col-md-8">
                <label class="form-label">Impact</label>
                @Html.TextAreaFor(m => m.Impact, new { @class = "form-control", rows = 2, placeholder = "What stops working if the provider is down..." })
            </div>
            <div class="col-12">
                <label class="form-label">Description</label>
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3 })
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>
<script>
    $(function () {
        function enforceDistinct() {
            var s = $('#SourceApplicationId').val();
            var t = $('#TargetApplicationId').val();
            if (s && t && s === t) {
                alert('Source and Target cannot be the same application.');
                $('#TargetApplicationId').val('');
            }
        }
        $('#SourceApplicationId').change(enforceDistinct);
        $('#TargetApplicationId').change(enforceDistinct);

        $('#depEditForm').on('submit', function (e) {
            e.preventDefault();
            var $form = $(this);
            $.post($form.attr('action'), $form.serialize())
                .done(function (result) {
                    if (result.success) {
                        window.location.href = result.redirect;
                    } else {
                        $('#depEditModalContent').html(result.formHtml);
                    }
                })
                .fail(function () { alert('Failed to save dependency.'); });
        });
    });
</script>